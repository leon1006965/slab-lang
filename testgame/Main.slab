<app>
<window title="Hello World">
<text>Hello World</text>
<button onclick="openwindow">Open a Alert Window</button>
<button onclick="goto Scene1">Enter a Scene</button>
<button onclick="consolemessage">Show Hello World in Console</button>
</window>
</app>

<function name="openwindow">
<alert message="This is a Alert"/>
</function>

<function name="consolemessage">
<print text="Hello World"/>
</function>









