{
    "name": "File Encrypter",
    "tag": "encrypt",
    "description": "Encrypt files with a password",
    "python": "encrypt.py",
    "syntax": "<encrypt file=\"path\" password=\"secret\">",
    "attributes": {
        "file": {
            "type": "string",
